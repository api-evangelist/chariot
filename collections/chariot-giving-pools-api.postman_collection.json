          "name": "List Giving Pools",
          "request": {
            "name": "List Giving Pools",
            "description": {
              "content": "Returns a list of Giving Pools accessible to the authenticated DAF account.\n\nGiving Pools represent individual named giving pools within a donor's DAF account (e.g. \"Smith Family Fund\").\nA [Donor Account](/api/donor-accounts) may be associated with multiple Giving Pools.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "giving_pools"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "donor_account_id",
                  "value": "<string>",
                  "description": "Filter Giving Pools by the ID of the associated [Donor Account](/api/donor-accounts)."
                },
                {
                  "disabled": false,
                  "key": "page_limit",
                  "value": "10",
                  "description": "The number of results to return. Defaults to 10, max is 100."
