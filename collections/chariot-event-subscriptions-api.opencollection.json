{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chariot FDX Accounts Event Subscriptions API",
    "version": "6.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://dashboard.givechariot.com/oauth/authorize",
      "accessTokenUrl": "https://api.givechariot.com/auth/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Event Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Event Subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givechariot.com/fdx/v6/v1/event_subscriptions",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the size of the list that is returned. The default (and maximum) is 100 objects."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "The cursor to use for pagination. If not set, the first page of results will be returned."
              }
            ]
          },
          "docs": "List all event subscriptions corresponding to your Chariot account."
        },
        {
          "info": {
            "name": "Create an Event Subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.givechariot.com/fdx/v6/v1/event_subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an event subscription corresponding to your Chariot account."
        },
        {
          "info": {
            "name": "Get an Event Subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givechariot.com/fdx/v6/v1/event_subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the event subscription"
              }
            ]
          },
          "docs": "Retrieve an event subscription with the given ID."
        },
        {
          "info": {
            "name": "Update an Event Subscription",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.givechariot.com/fdx/v6/v1/event_subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the event subscription"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an event subscription with the given ID."
        }
      ]
    }
  ],
  "bundled": true
}