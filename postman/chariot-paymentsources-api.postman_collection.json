{
  "info": {
    "_postman_id": "9222664b-df07-4c16-8e70-93521012b55b",
    "name": "Chariot FDX Accounts paymentSources API",
    "description": "Financial Data Exchange (FDX) v6 compatible API for read-only access to Chariot bank account data. Implements the FDX v6 standard for account information, transactions, and statements.\n\nContact Support:\n Name: Chariot Development Team\n Email: developers@givechariot.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:20:04.000Z",
    "updatedAt": "2026-07-28T01:20:04.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-9222664b-df07-4c16-8e70-93521012b55b"
  },
