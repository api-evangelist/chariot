          "request": {
            "name": "Create Nonprofit Contacts",
            "description": {
              "content": "Submit contact information for one or more nonprofits. Uploaded\ncontacts are used as suggestions for who to notify about disbursements.",
              "type": "text/plain"
            },
            "url": {
