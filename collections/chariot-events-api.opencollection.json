{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chariot FDX Accounts Events API",
    "version": "6.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://dashboard.givechariot.com/oauth/authorize",
      "accessTokenUrl": "https://api.givechariot.com/auth/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givechariot.com/fdx/v6/v1/events",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the size of the list that is returned. The default (and maximum) is 100 objects."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "The cursor to use for pagination. If not set, the first page of results will be returned."
              },
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "Filter Events for those with the specified category.\n"
              }
            ]
          },
          "docs": "List all events corresponding to your Chariot account."
        },
        {
          "info": {
            "name": "Get Event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givechariot.com/fdx/v6/v1/events/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique id for the event"
              }
            ]
          },
          "docs": "Retrieve an event with the given ID."
        }
      ]
    }
  ],
  "bundled": true
}