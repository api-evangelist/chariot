{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chariot FDX Accounts Deposits API",
    "version": "6.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://dashboard.givechariot.com/oauth/authorize",
      "accessTokenUrl": "https://api.givechariot.com/auth/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "deposits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Deposits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givechariot.com/fdx/v6/v1/deposits",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the size of the list that is returned. The default (and maximum) is 100 objects."
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "The cursor to use for pagination. If not set, the first page of results will be returned."
              },
              {
                "name": "payment_source_id",
                "value": "payment_source_01j8rs605a4gctmbm58d87mvsj",
                "type": "query",
                "description": "The unique identifier for the payment sources to filter deposits by. Comma separated list of payment source IDs."
              },
              {
                "name": "settled_at.after",
                "value": "",
                "type": "query",
                "description": "Return deposits with a settled date and time after the given date and time."
              },
              {
                "name": "settled_at.before",
                "value": "",
                "type": "query",
                "description": "Return deposits with a settled date and time before the given date and time."
              }
            ]
          },
          "docs": "List deposits for your account."
        },
        {
          "info": {
            "name": "Get a Deposit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givechariot.com/fdx/v6/v1/deposits/:id",
            "params": [
              {
                "name": "id",
                "value": "deposit_01j8rs605a4gctmbm58d87mvsj",
                "type": "path",
                "description": "The unique identifier for the deposit"
              }
            ]
          },
          "docs": "Get a deposit by its unique identifier."
        }
      ]
    }
  ],
  "bundled": true
}