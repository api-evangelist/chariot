{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chariot FDX Accounts Nonprofit Contacts API",
    "version": "6.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://dashboard.givechariot.com/oauth/authorize",
      "accessTokenUrl": "https://api.givechariot.com/auth/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "nonprofitContacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Nonprofit Contacts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.givechariot.com/fdx/v6/v1/nonprofit_contacts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit contact information for one or more nonprofits. Uploaded\ncontacts are used as suggestions for who to notify about disbursements."
        }
      ]
    }
  ],
  "bundled": true
}