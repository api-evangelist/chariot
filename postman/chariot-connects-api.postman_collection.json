                  "raw": "{\n  \"organization_id\": \"<string>\",\n  \"contact\": {\n    \"email\": \"<string>\",\n    \"phone\": \"<string>\",\n    \"first_name\": \"<string>\",\n    \"last_name\": \"<string>\"\n  },\n  \"name\": \"<string>\",\n  \"metadata\": {\n    \"cillum4ce\": \"<string>\"\n  }\n}",
