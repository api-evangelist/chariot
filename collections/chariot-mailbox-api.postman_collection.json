        {
          "id": "441961a8-966d-4a43-9859-11c021d30f1d",
          "name": "Get a Batch Upload URL",
          "request": {
            "name": "Get a Batch Upload URL",
            "description": {
              "content": "Returns a presigned URL for uploading a mailbox batch.\n\nA batch is a ZIP file containing TIFF images and a CSV index file.\nThe CSV must conform to the [Batch Format](/v2026-01-15/guides/lockbox-providers/batch-format) specification.\n\nThe `location_id` must match the format `po_<number>` (e.g., `po_543`).\nThe returned URL is a presigned S3 URL valid for 15 minutes. Upload the batch ZIP file using an HTTP PUT request to this URL.\n\nSee the [Mail Uploads guide](/v2026-01-15/guides/lockbox-providers/mail-uploads) for details on the upload and rescan process.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "mailbox",
                "upload_url"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location_id\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "37fe1dbc-1c37-4016-a734-cc31ad50895d",
              "name": "Successfully generated a presigned upload URL.",
