          "name": "List Donor Advised Funds",
          "request": {
            "name": "List Donor Advised Funds",
            "description": {
              "content": "Returns a list of all Donor Advised Funds within Chariot's system. This API allows for paginating over many results.\n\n<Note>\nIf there are DAFs missing from the list, please contact support at support@givechariot.com.\n</Note>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "dafs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "supportedOnly",
                  "value": "false",
                  "description": "If set to true, filters DAFs to only those that have a direct integration with Chariot."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "If included, filters DAFs to only those that contain the query. This parameter is case insensitive."
                },
                {
                  "disabled": false,
                  "key": "pageLimit",
                  "value": "10",
                  "description": "the number of results to return; defaults to 10, max is 100"
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "A token to use to retrieve the next page of results. This is useful for paginating over many pages of results. If set, all other arguments are expected to be kept the same as previous calls."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
