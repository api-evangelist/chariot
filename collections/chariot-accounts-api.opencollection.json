{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chariot FDX Accounts API",
    "version": "6.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://dashboard.givechariot.com/oauth/authorize",
      "accessTokenUrl": "https://api.givechariot.com/auth/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givechariot.com/fdx/v6/accounts",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page. Clamped to the range 10–100."
              },
              {
                "name": "pageKey",
                "value": "",
                "type": "query",
                "description": "Cursor token for pagination. Pass the `nextPageKey` value from a previous response."
              }
            ]
          },
          "docs": "Search and retrieve customer deposit accounts."
        },
        {
          "info": {
            "name": "Get account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givechariot.com/fdx/v6/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the account"
              }
            ]
          },
          "docs": "Get account balances, liabilities, and other detailed account information for a single deposit account."
        }
      ]
    }
  ],
  "bundled": true
}