                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"request_id\": \"<string>\",\n  \"location_id\": \"<string>\",\n  \"address\": {\n    \"city\": \"<string>\",\n    \"country\": \"<string>\",\n    \"line1\": \"<string>\",\n    \"postal_code\": \"<string>\",\n    \"state\": \"<string>\",\n    \"line2\": \"<string>\"\n  }\n}",
