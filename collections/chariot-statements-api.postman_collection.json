        {
          "id": "ff594028-e1cf-4b69-ac8c-0f90a1b0d059",
          "name": "List account statements",
          "request": {
            "name": "List account statements",
            "description": {
              "content": "Get a paginated list of statements for an account. When specifying a date range, both startTime and endTime must be provided together. Defaults to the last 7 days if no date range is specified. Data is available for up to 24 months from the current date.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":id",
                "statements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Number of results per page. Clamped to the range 10–100."
                },
                {
                  "disabled": false,
                  "key": "pageKey",
                  "value": "<uuid>",
                  "description": "Cursor token for pagination. Pass the `nextPageKey` value from a previous response."
                },
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<date>",
                  "description": "Start date for filtering results (inclusive). Format: YYYY-MM-DD. Must be specified together with endTime or omitted entirely."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<date>",
                  "description": "End date for filtering results (inclusive). Format: YYYY-MM-DD. Must be specified together with startTime or omitted entirely."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Unique identifier for the account"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
